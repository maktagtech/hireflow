# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel, set these under Settings > Environment Variables (see DEPLOY.md).

# --- Required ---------------------------------------------------------------
# Neon Postgres connection string (use the *pooled* one). In Vercel:
# Storage > Create Database > Neon fills this in automatically.
# A local Postgres also works: postgres://localhost:5432/hireflow
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx-pooler.us-west-2.aws.neon.tech/neondb?sslmode=require"
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# --- File storage (required on Vercel) -----------------------------------------
# Uploaded resumes and generated PDF/DOCX files.
# Vercel: Storage > Create > Blob (private) adds BLOB_STORE_ID (or, on older stores,
# BLOB_READ_WRITE_TOKEN) automatically.
# Locally, leave these empty to store files on disk in LOCAL_STORAGE_DIR.
# BLOB_STORE_ID=
# BLOB_READ_WRITE_TOKEN=
# Or Amazon S3 instead (credentials come from the standard AWS variables):
# S3_BUCKET=
# AWS_REGION=us-east-1
# LOCAL_STORAGE_DIR=.storage

# --- AI provider (optional) -------------------------------------------------
# Leave every key empty to run the deterministic offline engine.
# Otherwise the first provider with a key is used, or force one with AI_PROVIDER.
# AI_PROVIDER=anthropic   # anthropic | openai | gemini | offline
# AI_MODEL=               # override the provider's default model
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Public site / legal ----------------------------------------------------
# Shown in the Privacy Policy, Terms and emails.
NEXT_PUBLIC_SITE_NAME=HireFlow
NEXT_PUBLIC_OPERATOR_NAME=          # legal entity, e.g. "Acme Labs Ltd"
NEXT_PUBLIC_CONTACT_EMAIL=          # privacy / support contact
# Absolute URL used in email links. On Vercel it falls back to the production
# domain automatically; set it once you add a custom domain.
APP_URL=http://localhost:3000

# --- Email (optional) -------------------------------------------------------
# Without RESEND_API_KEY, emails are printed to the server log (dev only).
RESEND_API_KEY=
EMAIL_FROM="HireFlow <hello@yourdomain.com>"

# --- Beta access --------------------------------------------------------------
# true = signing up requires an invite code (create them with `npm run invite`).
BETA_INVITE_ONLY=true
